<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamingDigest.Contracts\StreamingDigest.Contracts.csproj" />
  </ItemGroup>

  <Target Name="CreateDotnetJsAlias" AfterTargets="Build">
    <ItemGroup>
      <BootDotnetJsCandidate Include="$(TargetDir)wwwroot\_framework\dotnet.*.js"
                             Exclude="$(TargetDir)wwwroot\_framework\dotnet.native.*.js;$(TargetDir)wwwroot\_framework\dotnet.runtime.*.js;$(TargetDir)wwwroot\_framework\dotnet.js" />
    </ItemGroup>

    <Copy SourceFiles="@(BootDotnetJsCandidate)"
          DestinationFiles="@(BootDotnetJsCandidate->'$(TargetDir)wwwroot\_framework\dotnet.js')"
          SkipUnchangedFiles="true"
          Condition="'@(BootDotnetJsCandidate)' != ''" />
  </Target>

</Project>
