<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamingDigest.Contracts\StreamingDigest.Contracts.csproj" />
  </ItemGroup>

  <!-- Flattened ASP.NET Core hosted shape: the WASM client bootstrap is excluded from
       server compilation (only one top-level-statements file is allowed) and shipped as
       a content file so the WebAssembly.Sdk tooling can locate the client entry point. -->
  <ItemGroup>
    <Compile Remove="ClientProgram.cs" />
    <Content Include="ClientProgram.cs" />
  </ItemGroup>

</Project>
