@page "/change-password"
@layout PublicLayout
@inject AuthenticationService AuthenticationService
@inject NavigationManager NavigationManager

<PageTitle>Change password</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="brand-block">
            <div class="brand-mark">◉</div>
            <h1>Change your password</h1>
            <p>Your account requires a password update before you can continue.</p>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleChangePasswordAsync">
            <div class="form-group">
                <label for="current-password">Current password</label>
                <InputText id="current-password" class="form-control" type="password" @bind-Value="_model.CurrentPassword" />
            </div>

            <div class="form-group">
                <label for="new-password">New password</label>
                <InputText id="new-password" class="form-control" type="password" @bind-Value="_model.NewPassword" />
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirm new password</label>
                <InputText id="confirm-password" class="form-control" type="password" @bind-Value="_model.ConfirmPassword" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-error">@_errorMessage</div>
            }

            <button class="primary-button" type="submit">Update password</button>
        </EditForm>
    </div>
</div>

@code {
    private readonly ChangePasswordModel _model = new();
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthenticationService.InitializeAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!AuthenticationService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!AuthenticationService.RequiresPasswordChange)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.CurrentPassword) || string.IsNullOrWhiteSpace(_model.NewPassword) || string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _errorMessage = "Please complete all password fields.";
            return;
        }

        if (!string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "The new passwords do not match.";
            return;
        }

        if (await AuthenticationService.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _errorMessage = "We could not update the password. Please verify your current password and try again.";
    }

    private sealed class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
