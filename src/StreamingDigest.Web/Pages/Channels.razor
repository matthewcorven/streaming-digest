@page "/channels"

<PageTitle>Channels</PageTitle>

<div class="page-shell">
    <section class="hero-card">
        <div>
            <p class="eyebrow">Channels</p>
            <h1>Channel coverage</h1>
            <p>Review the sources feeding ingestion, search, and the daily digest.</p>
        </div>
        <a class="primary-button" href="/settings">Open admin settings</a>
    </section>

    <section class="card-list">
        <article class="card">
            <div class="card-header">
                <h2>Developer Weekly</h2>
                <span class="status-pill status-ready">Healthy</span>
            </div>
            <p class="card-body">Three new videos were processed in the last 24 hours.</p>
        </article>

        <article class="card">
            <div class="card-header">
                <h2>Build & Release</h2>
                <span class="status-pill status-neutral">Awaiting run</span>
            </div>
            <p class="card-body">Next run is scheduled for 18:30 UTC.</p>
        </article>

        <article class="card">
            <div class="card-header">
                <h2>LangChain Notes</h2>
                <span class="status-pill status-warning">Needs review</span>
            </div>
            <p class="card-body">A recent run surfaced a duplicate video cluster.</p>
        </article>
    </section>
</div>
