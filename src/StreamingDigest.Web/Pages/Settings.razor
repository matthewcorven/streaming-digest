@page "/admin"
@page "/settings"

@using System.Net.Http.Json
@using System.Text.Json
@using StreamingDigest.Web.Models
@using StreamingDigest.Web.Pages
@using StreamingDigest.Web.Services

@inject SearchUiSessionService SearchUiSessionService
@inject ModelStatusService ModelStatusService

@implements IAsyncDisposable

<PageTitle>Admin</PageTitle>

<div class="admin-page-shell">
    <section class="hero-card">
        <div>
            <p class="eyebrow">Admin console</p>
            <h1>Settings, models, observability, and maintenance</h1>
            <p>The admin surface now connects to the runtime settings and observability endpoints so operators can monitor readiness and adjust core services from one place.</p>
        </div>
        <div class="hero-actions">
            <a class="secondary-button" href="/ingestion">Review ingestion runs</a>
            <a class="secondary-button" href="/admin/upgrade-maintenance">Open maintenance view</a>
        </div>
    </section>

    <section class="admin-actions-card">
        <div class="section-heading">
            <div>
                <h2>Operational status</h2>
                <p class="page-description">The view below syncs against the live admin API and surfaces the latest runtime state.</p>
            </div>
            <span class="status-pill @GetStatusClass(_statusTone)">@(_isLoading ? "Loading" : _statusTone)</span>
        </div>
        <div class="action-buttons">
            <button class="action-button" type="button" disabled="@(_isLoading || _isSaving)" @onclick="ReloadAsync">Refresh</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <p class="action-feedback @_statusTone">@_statusMessage</p>
        }
    </section>

    <section class="card-grid">
        <article class="card">
            <div class="card-header">
                <h2>Settings</h2>
                <span class="status-pill @GetStatusClass(_observabilityEnabled ? "success" : "neutral")">@(_observabilityEnabled ? "Enabled" : "Disabled")</span>
            </div>
            <div class="toggle-row">
                <label for="observability-enabled">Enable observability</label>
                <input id="observability-enabled" type="checkbox" checked="@_observabilityEnabled" @onchange="ToggleObservabilityAsync" disabled="@_isSaving" />
            </div>
            <dl class="kv-list">
                <div class="kv-row"><dt>Retention days</dt><dd>@_retentionDays</dd></div>
                <div class="kv-row"><dt>Retention warning</dt><dd>@(_retentionWarning ? "Required" : "Clear")</dd></div>
            </dl>
        </article>

        <article class="card">
            <div class="card-header">
                <h2>Runtime config</h2>
                <span class="status-pill status-neutral">@(_runtimeEnvironment)</span>
            </div>
            <dl class="kv-list">
                <div class="kv-row"><dt>Environment</dt><dd>@_runtimeEnvironment</dd></div>
                <div class="kv-row"><dt>Deploy mode</dt><dd>@_deployMode</dd></div>
            </dl>
            <ul class="stack-list">
                @foreach (var feature in _features)
                {
                    <li>@feature</li>
                }
            </ul>
        </article>

        <article class="card models-card">
            <div class="card-header">
                <h2>Models</h2>
                <div class="card-header-meta">
                    @if (ModelStatusService.ActiveOperationsCount > 0)
                    {
                        <span class="status-pill status-info" aria-live="polite">@ModelStatusService.ActiveOperationsCount @(ModelStatusService.ActiveOperationsCount == 1 ? "operation" : "operations") in progress</span>
                    }
                    <span class="status-pill @GetConnectionStripCssClass()" aria-live="polite">@GetConnectionStripLabel()</span>
                </div>
            </div>
            @if (ModelStatusService.ConnectionState == SseConnectionState.Paused)
            {
                <div class="connection-notice connection-notice--paused">
                    <span>Live updates paused — reconnection stopped after repeated failures.</span>
                    <button class="secondary-button compact" type="button" @onclick="RefreshModelsAsync">Refresh all</button>
                </div>
            }
            else if (ModelStatusService.ConnectionState == SseConnectionState.Reconnecting)
            {
                <div class="connection-notice connection-notice--reconnecting">
                    <span>Reconnecting to live updates…</span>
                    <button class="secondary-button compact" type="button" @onclick="RefreshModelsAsync">Refresh all</button>
                </div>
            }
            <ul class="stack-list model-rows" aria-label="Models">
                @foreach (var model in ModelStatusService.Models)
                {
                    <li class="model-row" data-model-id="@model.Id" data-state="@model.RowState.ToString().ToLowerInvariant()">
                        <div class="list-title-row">
                            <strong>@model.Label</strong>
                            <span class="status-pill @model.BadgeCssModifier" aria-live="polite">@model.BadgeText</span>
                        </div>
                        <div class="meta-row">
                            <span class="model-meta">@model.Provider · @model.Family · @model.Id</span>
                            @if (!model.Downloadable)
                            {
                                <span class="model-external-hint">Managed externally</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.ErrorMessage))
                        {
                            <p class="model-error" role="alert">@model.ErrorMessage</p>
                        }
                        <div class="model-actions">
                            @* Download CTA — Ollama only *@
                            @if (model.ShowDownloadCta && !model.ShowRetryDownload)
                            {
                                <button class="action-button compact" type="button"
                                        disabled="@model.IsActionBusy"
                                        @onclick="() => HandleDownloadAsync(model)">
                                    Queue download
                                </button>
                            }
                            @if (model.ShowRetryDownload)
                            {
                                <button class="secondary-button compact" type="button"
                                        disabled="@model.IsActionBusy"
                                        @onclick="() => HandleDownloadAsync(model)">
                                    Retry download
                                </button>
                            }
                            @* Verify CTA *@
                            @if (model.ShowVerifyCta)
                            {
                                <button class="secondary-button compact" type="button"
                                        disabled="@model.IsActionBusy"
                                        @onclick="() => HandleVerifyAsync(model)">
                                    @model.VerifyCtaLabel
                                </button>
                            }
                            @* Refresh secondary CTA *@
                            @if (model.ShowRefreshCta)
                            {
                                <button class="secondary-button compact" type="button"
                                        @onclick="RefreshModelsAsync">
                                    Refresh
                                </button>
                            }
                        </div>
                    </li>
                }
                @if (!ModelStatusService.Models.Any() && !_isLoading)
                {
                    <li class="model-row model-row--empty">
                        <span>No models loaded. <button class="link-button" @onclick="RefreshModelsAsync">Refresh</button> to reload.</span>
                    </li>
                }
            </ul>
        </article>
    </section>

    <section class="card-grid accent-grid">
        <article class="card">
            <div class="card-header">
                <h2>Observability</h2>
                <span class="status-pill status-neutral">Live links</span>
            </div>
            <ObservabilityPanel />
        </article>

        <article class="card">
            <div class="card-header">
                <h2>Backup & maintenance</h2>
                <span class="status-pill status-neutral">Operations</span>
            </div>
            <UpgradeMaintenancePanel />
        </article>
    </section>
</div>

@code {
    private bool _isLoading;
    private bool _isSaving;
    private string _statusMessage = "Connecting to the admin API…";
    private string _statusTone = "neutral";
    private bool _observabilityEnabled;
    private int _retentionDays;
    private bool _retentionWarning;
    private string _runtimeEnvironment = "—";
    private string _deployMode = "—";
    private IReadOnlyList<string> _features = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to model state changes so the page re-renders when rows update.
        ModelStatusService.Changed += OnModelStateChanged;
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        ModelStatusService.Changed -= OnModelStateChanged;
        await ModelStatusService.DisposeAsync();
    }

    private void OnModelStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _statusTone = "neutral";
        _statusMessage = "Connecting to the admin API…";

        try
        {
            await EnsureApiSessionAsync();

            var settings = await SearchUiSessionService.GetAuthenticatedJsonAsync<AdminSettingsResponse>("/api/settings");
            var runtime = await SearchUiSessionService.GetAuthenticatedJsonAsync<RuntimeSettingsResponse>("/api/config/runtime");

            var values = settings?.Values ?? new Dictionary<string, JsonElement>();
            _observabilityEnabled = ReadBool(values, "observability.enabled", false);
            _retentionDays = ReadInt(values, "observability.retentionDays", 0);
            _retentionWarning = ReadBool(values, "observability.retentionWarning", false);

            _runtimeEnvironment = runtime?.Environment ?? "unknown";
            _deployMode = runtime?.DeployMode ?? "unknown";
            _features = runtime?.Features ?? Array.Empty<string>();

            // Initialize the per-row model state machine + SSE subscription.
            await ModelStatusService.InitializeAsync();

            _statusMessage = "Admin data loaded from the live API.";
            _statusTone = "success";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Unable to load the admin experience: {ex.Message}";
            _statusTone = "error";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshModelsAsync()
    {
        await ModelStatusService.RefreshAsync();
        StateHasChanged();
    }

    private async Task HandleDownloadAsync(ModelRowViewModel model)
    {
        await ModelStatusService.Download(model);
    }

    private async Task HandleVerifyAsync(ModelRowViewModel model)
    {
        await ModelStatusService.Verify(model);
    }

    private async Task ToggleObservabilityAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is bool value
            ? value
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        _isSaving = true;
        _statusTone = "neutral";
        _statusMessage = "Saving observability settings…";

        try
        {
            await EnsureApiSessionAsync();

            using var request = new HttpRequestMessage(HttpMethod.Put, "/api/settings");
            request.Content = JsonContent.Create(new Dictionary<string, object?>
            {
                ["observability.enabled"] = enabled
            });

            using var response = await SearchUiSessionService.SendAuthenticatedRequestAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException($"The admin API rejected the update with {(int)response.StatusCode}.");
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Unable to update observability: {ex.Message}";
            _statusTone = "error";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task EnsureApiSessionAsync()
        => SearchUiSessionService.EnsureAuthenticatedSessionAsync();

    // ── Connection strip helpers ───────────────────────────────────────────────────────────

    private string GetConnectionStripLabel() => ModelStatusService.ConnectionState switch
    {
        SseConnectionState.Connected => "Live updates connected",
        SseConnectionState.Connecting => "Connecting…",
        SseConnectionState.Reconnecting => "Reconnecting…",
        SseConnectionState.Paused => "Live updates paused",
        _ => "Live updates off"
    };

    private string GetConnectionStripCssClass() => ModelStatusService.ConnectionState switch
    {
        SseConnectionState.Connected => "status-success",
        SseConnectionState.Connecting or SseConnectionState.Reconnecting => "status-warning",
        SseConnectionState.Paused or SseConnectionState.Disconnected => "status-neutral",
        _ => "status-neutral"
    };

    // ── General helpers ───────────────────────────────────────────────────────────────────

    private static bool ReadBool(IReadOnlyDictionary<string, JsonElement> values, string key, bool fallback)
    {
        if (!values.TryGetValue(key, out var value))
        {
            return fallback;
        }

        return value.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.String => bool.TryParse(value.GetString(), out var parsedBoolean) && parsedBoolean,
            JsonValueKind.Number => value.GetInt32() != 0,
            _ => fallback
        };
    }

    private static int ReadInt(IReadOnlyDictionary<string, JsonElement> values, string key, int fallback)
    {
        if (!values.TryGetValue(key, out var value))
        {
            return fallback;
        }

        return value.ValueKind switch
        {
            JsonValueKind.Number => value.GetInt32(),
            JsonValueKind.String when int.TryParse(value.GetString(), out var parsedInt) => parsedInt,
            _ => fallback
        };
    }

    private static string GetStatusClass(string tone)
        => tone.ToLowerInvariant() switch
        {
            "success" => "status-success",
            "warning" => "status-warning",
            "error" => "status-danger",
            _ => "status-neutral"
        };

    // ── Response types ─────────────────────────────────────────────────────────────────────

    private sealed class AdminSettingsResponse
    {
        public Dictionary<string, JsonElement>? Values { get; set; }
    }

    private sealed class RuntimeSettingsResponse
    {
        public string? Environment { get; set; }
        public string? DeployMode { get; set; }
        public string[]? Features { get; set; }
    }
}

