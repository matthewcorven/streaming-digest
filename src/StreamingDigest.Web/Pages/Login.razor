@page "/login"
@layout PublicLayout
@inject AuthenticationService AuthenticationService
@inject DashboardSummaryService DashboardSummaryService
@inject SearchUiSessionService SearchUiSessionService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="brand-block">
            <div class="brand-mark">◉</div>
            <h1>Stream Digest</h1>
            <p>Your video knowledge base, tuned for search and operations.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <p class="helper-text">@_successMessage</p>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
            <div class="form-group">
                <label for="username">Username</label>
                <InputText id="username" class="form-control" @bind-Value="_model.Username" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-field">
                    <InputText id="password" class="form-control" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.Password" />
                    <button class="password-toggle" type="button" @onclick="TogglePasswordVisibility">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-error">@_errorMessage</div>
            }

            <button class="primary-button" type="submit">Sign in</button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _showPassword;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationService.InitializeAsync();

        if (AuthenticationService.IsSetupRequired)
        {
            NavigationManager.NavigateTo("/setup");
            return;
        }

        if (AuthenticationService.IsAuthenticated)
        {
            NavigationManager.NavigateTo(await DetermineNavigationTargetAsync());
            return;
        }

        var query = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query.TrimStart('?');
        foreach (var segment in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = segment.Split('=', 2);
            if (parts.Length == 2
                && string.Equals(Uri.UnescapeDataString(parts[0]), "setup", StringComparison.OrdinalIgnoreCase)
                && string.Equals(Uri.UnescapeDataString(parts[1]), "success", StringComparison.OrdinalIgnoreCase))
            {
                _successMessage = "Setup complete. Sign in with the account you just created.";
                break;
            }
        }
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;

        var loginResult = await AuthenticationService.LoginAsync(_model.Username, _model.Password);
        if (loginResult is AuthenticationService.LoginResult.Success or AuthenticationService.LoginResult.RequiresPasswordChange)
        {
            NavigationManager.NavigateTo(await DetermineNavigationTargetAsync(loginResult));
            return;
        }

        _errorMessage = "Invalid username or password.";
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task<string> DetermineNavigationTargetAsync(AuthenticationService.LoginResult? loginResult = null)
    {
        if ((loginResult ?? (AuthenticationService.RequiresPasswordChange ? AuthenticationService.LoginResult.RequiresPasswordChange : AuthenticationService.LoginResult.Success)) == AuthenticationService.LoginResult.RequiresPasswordChange)
        {
            return "/change-password";
        }

        var returnUrl = TryGetReturnUrl();
        if (returnUrl is not null)
        {
            return returnUrl;
        }

        try
        {
            var onboarding = await SearchUiSessionService.GetAuthenticatedJsonAsync<OnboardingStatusResponse>("/api/onboarding/status");
            var runs = await SearchUiSessionService.GetAuthenticatedJsonAsync<List<IngestionRunFixtureSummary>>("/api/internal/ingestion-runs?limit=1");
            var lastSelectedMode = SearchUiSessionService.GetLastSelectedModeRoute();
            return DashboardSummaryService.ResolvePostLoginRoute(
                onboarding?.IsCoreSetupComplete ?? true,
                lastSelectedMode,
                runs is { Count: > 0 });
        }
        catch
        {
            return DashboardSummaryService.ResolvePostLoginRoute(
                isCoreSetupComplete: true,
                lastSelectedMode: SearchUiSessionService.GetLastSelectedModeRoute(),
                hasCompletedRun: false);
        }
    }

    private string? TryGetReturnUrl()
    {
        var query = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query.TrimStart('?');
        foreach (var segment in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = segment.Split('=', 2);
            if (parts.Length == 2
                && string.Equals(Uri.UnescapeDataString(parts[0]), "returnUrl", StringComparison.OrdinalIgnoreCase))
            {
                return ReturnUrlHelper.ResolveSafeReturnUrl(Uri.UnescapeDataString(parts[1]));
            }
        }

        return null;
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed class OnboardingStatusResponse
    {
        public bool IsCoreSetupComplete { get; set; }
    }
}
