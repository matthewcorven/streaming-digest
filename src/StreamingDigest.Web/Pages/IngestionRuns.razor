@page "/ingestion"
@using System.Net.Http.Json
@inject SearchUiSessionService SearchUiSessionService

<PageTitle>Ingestion runs</PageTitle>

<div class="ingestion-list-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Operations</p>
            <h1>Ingestion runs</h1>
        </div>
        <p class="page-description">Recent ingestion runs, with live status pulled from persisted run and item records.</p>
    </div>

    <section class="admin-actions-card">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Admin</p>
                <h2>Contextual operations</h2>
            </div>
            <p class="page-description">Trigger ingestion and backfill flows from the current ingestion surface.</p>
        </div>
        <div class="action-buttons">
            <button class="action-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetRunIngestionEndpoint(), GetRunIngestionLabel()))">Run ingestion now</button>
            <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetChannelBackfillEndpoint(), GetChannelBackfillLabel()))">Run channel backfill</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
        {
            <p class="action-feedback @_feedbackClass">@_feedbackMessage</p>
        }
    </section>

    @if (_runs.Count == 0)
    {
        <section class="section-card">
            <p class="muted">No ingestion runs are recorded yet. Run ingestion now to create the first run record.</p>
        </section>
    }
    else
    {
        <div class="fixture-grid">
        @foreach (var run in _runs)
        {
            <a class="fixture-card" href="@($"/ingestion/runs/{run.Id}")">
                <div class="fixture-card-header">
                    <h2>@run.Title</h2>
                    <span class="status-pill">@run.StatusText</span>
                </div>
                <p>@run.Subtitle</p>
            </a>
        }
        </div>
    }
</div>

@code {
    private readonly List<IngestionRunFixtureSummary> _runs = [];
    private bool _isBusy;
    private string? _feedbackMessage;
    private string _feedbackClass = "neutral";

    protected override async Task OnInitializedAsync()
    {
        await LoadRunsAsync();
    }

    private string GetRunIngestionEndpoint() => "/api/admin/operations/ingestion/run";

    private string GetChannelBackfillEndpoint() => "/api/admin/operations/ingestion/channel-backfill";

    private static string GetRunIngestionLabel() => "Run ingestion now";

    private static string GetChannelBackfillLabel() => "Run channel backfill";

    private async Task TriggerActionAsync(string endpoint, string label)
    {
        _isBusy = true;
        _feedbackMessage = $"Dispatching {label.ToLowerInvariant()}...";
        _feedbackClass = "neutral";

        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, endpoint);
            using var response = await SearchUiSessionService.SendAuthenticatedRequestAsync(request);
            var payload = await response.Content.ReadFromJsonAsync<AdminActionResponse>();

            if (response.IsSuccessStatusCode && payload is not null)
            {
                _feedbackMessage = payload.Status is "completed" or "ok"
                    ? $"{label} completed. {payload.Message}"
                    : $"{label} accepted. {payload.Message}";
                _feedbackClass = payload.Status is "completed" or "ok" ? "success" : "pending";
                await LoadRunsAsync();
            }
            else
            {
                _feedbackMessage = $"{label} failed to trigger.";
                _feedbackClass = "error";
            }
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"{label} could not be triggered: {ex.Message}";
            _feedbackClass = "error";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadRunsAsync()
    {
        try
        {
            var runs = await SearchUiSessionService.GetAuthenticatedJsonAsync<List<IngestionRunFixtureSummary>>("/api/internal/ingestion-runs");
            _runs.Clear();
            if (runs is not null)
            {
                _runs.AddRange(runs);
            }
        }
        catch
        {
            _runs.Clear();
        }
    }

    private sealed class AdminActionResponse
    {
        public string? Status { get; set; }
        public string? Message { get; set; }
    }
}
