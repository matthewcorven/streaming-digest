@page "/admin/upgrade-maintenance"

@using System.Net.Http.Json
@using StreamingDigest.Web.Models
@using StreamingDigest.Web.Services

@inject UpgradeMaintenanceSnapshotService SnapshotService
@inject HttpClient Http

<PageTitle>Upgrade & Maintenance</PageTitle>

@if (_snapshot is null)
{
    <div class="upgrade-maintenance-panel">
        <div class="loading-state">Loading upgrade diagnostics…</div>
    </div>
}
else
{
    var uiState = UpgradeMaintenanceUiMapper.Create(_snapshot);

    <div class="upgrade-maintenance-panel">
        <section class="hero-card">
            <div>
                <p class="eyebrow">Admin operations</p>
                <h1>@_snapshot.Title</h1>
                <p class="summary">@_snapshot.Summary</p>
            </div>
            <div class="hero-side">
                <span class="risk-pill @uiState.RiskBadgeClass">@_snapshot.Risk.Level</span>
                <div class="next-action">
                    <span class="label">Required next action</span>
                    <strong>@uiState.RequiredNextAction</strong>
                </div>
            </div>
        </section>

        <section class="admin-actions-card">
            <div class="card-header">
                <h2>Operational actions</h2>
                <span class="status-pill status-neutral">Contextual admin</span>
            </div>
            <p class="pre-migration-backup-note">
                Backup guidance: create a backup before DB/config/deployment migrations; backup is required for high-risk infrastructure migrations.
            </p>
            <div class="action-buttons">
                <button class="action-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetEmbeddingsReprocessEndpoint(), GetEmbeddingsReprocessLabel()))">Reprocess embeddings</button>
                <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetMatrixNotificationEndpoint(), GetMatrixNotificationLabel()))">Test Matrix notification</button>
                <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetEmbeddingServiceEndpoint(), GetEmbeddingServiceLabel()))">Test embedding service</button>
                <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetAudioToTextEndpoint(), GetAudioToTextLabel()))">Test audio-to-text service</button>
                <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetBackupEndpoint(), GetBackupLabel()))">Create backup archive</button>
                <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="@(() => TriggerActionAsync(GetRestoreEndpoint(), GetRestoreLabel()))">Restore latest backup</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
            {
                <p class="action-feedback @_feedbackClass">@_feedbackMessage</p>
                @if (!string.IsNullOrWhiteSpace(_downloadUrl))
                {
                    <a class="secondary-link" href="@_downloadUrl" target="_blank" rel="noopener">Download archive</a>
                }
            }
        </section>

        <section class="panel-grid">
            <article class="card">
                <div class="card-header">
                    <h2>Current versions</h2>
                    <span class="status-pill status-success">Aligned</span>
                </div>
                <dl class="kv-list">
                    <div class="kv-row"><dt>App</dt><dd>@_snapshot.Versions.AppVersion</dd></div>
                    <div class="kv-row"><dt>DB schema</dt><dd>@_snapshot.Versions.DbSchemaVersion</dd></div>
                    <div class="kv-row"><dt>Config schema</dt><dd>@_snapshot.Versions.ConfigSchemaVersion</dd></div>
                    <div class="kv-row"><dt>Deployment schema</dt><dd>@_snapshot.Versions.DeploymentSchemaVersion</dd></div>
                </dl>
                <p class="card-footnote">@_snapshot.Versions.CompatibilitySummary</p>
            </article>

            <article class="card">
                <div class="card-header">
                    <h2>Upgrade status</h2>
                    <span class="status-pill status-warning">@_snapshot.Upgrade.Status</span>
                </div>
                <p class="card-body">@_snapshot.Upgrade.Summary</p>
            </article>

            <article class="card">
                <div class="card-header">
                    <h2>Backup status</h2>
                    <span class="status-pill status-success">@_snapshot.Backup.Health</span>
                </div>
                <dl class="kv-list">
                    <div class="kv-row"><dt>Last backup</dt><dd>@FormatTimestamp(_snapshot.Backup.LastBackupAt)</dd></div>
                    <div class="kv-row"><dt>Location</dt><dd>@_snapshot.Backup.Location</dd></div>
                </dl>
                <p class="card-body">@_snapshot.Backup.Summary</p>
            </article>

            <article class="card">
                <div class="card-header">
                    <h2>Migration preview</h2>
                    <span class="status-pill status-neutral">@_snapshot.MigrationPreview.Count item(s)</span>
                </div>
                <ul class="stack-list">
                    @foreach (var item in _snapshot.MigrationPreview)
                    {
                        <li>
                            <div class="list-title-row">
                                <strong>@item.Label</strong>
                                <span class="status-pill status-neutral">@item.Status</span>
                            </div>
                            <div class="meta-row"><span>@item.Kind</span><span>@item.Details</span></div>
                        </li>
                    }
                </ul>
            </article>

            <article class="card">
                <div class="card-header">
                    <h2>Service compatibility</h2>
                    <span class="status-pill status-neutral">Health checks</span>
                </div>
                <ul class="stack-list">
                    @foreach (var service in _snapshot.Services)
                    {
                        <li>
                            <div class="list-title-row">
                                <strong>@service.Name</strong>
                                <span class="status-pill @GetServiceStatusClass(service.Status)">@service.Status</span>
                            </div>
                            <div class="meta-row"><span>@(service.IsRequired ? "Required" : "Optional")</span><span>@service.Summary</span></div>
                        </li>
                    }
                </ul>
            </article>

            <article class="card">
                <div class="card-header">
                    <h2>Derived-data status</h2>
                    <span class="status-pill status-warning">Needs attention</span>
                </div>
                <dl class="kv-list">
                    <div class="kv-row"><dt>Stale embeddings</dt><dd>@_snapshot.DerivedData.StaleEmbeddings</dd></div>
                    <div class="kv-row"><dt>Stale search docs</dt><dd>@_snapshot.DerivedData.StaleSearchDocuments</dd></div>
                    <div class="kv-row"><dt>Pending approvals</dt><dd>@_snapshot.DerivedData.PendingSegmentApprovals</dd></div>
                    <div class="kv-row"><dt>Index rebuilds</dt><dd>@_snapshot.DerivedData.IndexRebuilds</dd></div>
                </dl>
                <p class="card-body">@_snapshot.DerivedData.Summary</p>
            </article>

            <article class="card checklist-card">
                <div class="card-header">
                    <h2>Post-upgrade checklist</h2>
                    <span class="status-pill status-neutral">@_snapshot.Checklist.Count checks</span>
                </div>
                <ul class="stack-list">
                    @foreach (var item in _snapshot.Checklist)
                    {
                        <li>
                            <div class="list-title-row">
                                <strong>@item.Label</strong>
                                <span class="status-pill @GetChecklistStatusClass(item.Status)">@item.Status</span>
                            </div>
                            <div class="meta-row"><span>@item.Details</span></div>
                        </li>
                    }
                </ul>
            </article>
        </section>
    </div>
}

@code {
    private UpgradeMaintenanceSnapshot? _snapshot;
    private bool _isBusy;
    private string? _feedbackMessage;
    private string? _downloadUrl;
    private string _feedbackClass = "neutral";

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await SnapshotService.GetSnapshotAsync();
    }

    private static string GetEmbeddingsReprocessEndpoint() => "/api/admin/operations/embeddings/reprocess";

    private static string GetMatrixNotificationEndpoint() => "/api/admin/operations/notifications/matrix/test";

    private static string GetEmbeddingServiceEndpoint() => "/api/admin/operations/embeddings/test";

    private static string GetAudioToTextEndpoint() => "/api/admin/operations/audio-to-text/test";
 
    private static string GetBackupEndpoint() => "/api/admin/operations/backup";

    private static string GetRestoreEndpoint() => "/api/admin/operations/restore";
  
    private static string GetEmbeddingsReprocessLabel() => "Reprocess embeddings";
  
    private static string GetMatrixNotificationLabel() => "Test Matrix notification";
  
    private static string GetEmbeddingServiceLabel() => "Test embedding service";
  
    private static string GetAudioToTextLabel() => "Test audio-to-text service";
  
    private static string GetBackupLabel() => "Create backup archive";

    private static string GetRestoreLabel() => "Restore latest backup";

    private async Task TriggerActionAsync(string endpoint, string label)
    {
        _isBusy = true;
        _feedbackMessage = $"Dispatching {label.ToLowerInvariant()}...";
        _downloadUrl = null;
        _feedbackClass = "neutral";

        try
        {
            using var response = await Http.PostAsync(endpoint, null);
            var payload = await response.Content.ReadFromJsonAsync<AdminActionResponse>();

            if (response.IsSuccessStatusCode && payload is not null)
            {
                _downloadUrl = payload.OperationType is "backup.create" && !string.IsNullOrWhiteSpace(payload.Target)
                    ? $"/api/admin/operations/backups/{Uri.EscapeDataString(payload.Target)}"
                    : null;
                _feedbackMessage = payload.Status is "completed" or "ok"
                    ? $"{label} completed. {payload.Message}"
                    : $"{label} accepted. {payload.Message}";
                _feedbackClass = payload.Status is "completed" or "ok" ? "success" : "pending";
            }
            else
            {
                _feedbackMessage = $"{label} failed to trigger.";
                _feedbackClass = "error";
            }
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"{label} could not be triggered: {ex.Message}";
            _feedbackClass = "error";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string FormatTimestamp(string value)
        => DateTimeOffset.TryParse(value, out var parsed) ? parsed.ToString("yyyy-MM-dd HH:mm") : value;

    private static string GetServiceStatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "healthy" or "ready" or "up-to-date" => "status-success",
            "warning" or "degraded" or "backup recommended" => "status-warning",
            "blocked" or "critical" or "failed" => "status-danger",
            _ => "status-neutral"
        };

    private static string GetChecklistStatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "ready" or "done" or "complete" => "status-success",
            "pending" or "in progress" => "status-warning",
            "blocked" or "failed" => "status-danger",
            _ => "status-neutral"
        };

    private sealed class AdminActionResponse
    {
        public string? OperationType { get; set; }
        public string? Status { get; set; }
        public string? Message { get; set; }
        public string? Target { get; set; }
    }
}
