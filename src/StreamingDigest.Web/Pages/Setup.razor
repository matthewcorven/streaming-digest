@page "/setup"
@layout PublicLayout
@inject AuthenticationService AuthenticationService
@inject DashboardSummaryService DashboardSummaryService
@inject SearchUiSessionService SearchUiSessionService
@inject NavigationManager NavigationManager

<PageTitle>First-time setup</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="brand-block">
            <div class="brand-mark">◉</div>
            <h1>Create the first account</h1>
            <p>Set the initial administrator credentials for this Stream Digest installation.</p>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleSetupAsync">
            <div class="form-group">
                <label for="username">Username</label>
                <InputText id="username" class="form-control" @bind-Value="_model.Username" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-field">
                    <InputText id="password" class="form-control" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.Password" />
                    <button class="password-toggle" type="button" @onclick="TogglePasswordVisibility">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirm password</label>
                <InputText id="confirm-password" class="form-control" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.ConfirmPassword" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-error">@_errorMessage</div>
            }

            <button class="primary-button" type="submit">Create account</button>
        </EditForm>

        <p class="helper-text">Passwords must be at least 12 characters. After setup, you will sign in on the normal login page.</p>
    </div>
</div>

@code {
    private readonly SetupModel _model = new();
    private bool _showPassword;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationService.InitializeAsync();

        if (!AuthenticationService.IsSetupRequired)
        {
            if (AuthenticationService.IsAuthenticated)
            {
                NavigationManager.NavigateTo(await DeterminePostLoginRouteAsync(), true);
                return;
            }

            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task HandleSetupAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Username) || string.IsNullOrWhiteSpace(_model.Password) || string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _errorMessage = "Please complete all fields.";
            return;
        }

        if (!string.Equals(_model.Password, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "The passwords do not match.";
            return;
        }

        var result = await AuthenticationService.InitializeFirstUserAsync(_model.Username, _model.Password);
        if (result.ResultType == AuthenticationService.FirstUserSetupResultType.Success)
        {
            NavigationManager.NavigateTo("/login?setup=success", true);
            return;
        }

        if (result.ResultType == AuthenticationService.FirstUserSetupResultType.AlreadyInitialized)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        _errorMessage = result.ErrorMessage ?? "The account could not be created.";
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task<string> DeterminePostLoginRouteAsync()
    {
        if (AuthenticationService.RequiresPasswordChange)
        {
            return "/change-password";
        }

        try
        {
            var onboarding = await SearchUiSessionService.GetAuthenticatedJsonAsync<OnboardingStatusResponse>("/api/onboarding/status");
            var runs = await SearchUiSessionService.GetAuthenticatedJsonAsync<List<IngestionRunFixtureSummary>>("/api/internal/ingestion-runs?limit=1");
            return DashboardSummaryService.ResolvePostLoginRoute(
                onboarding?.IsCoreSetupComplete ?? true,
                SearchUiSessionService.GetLastSelectedModeRoute(),
                runs is { Count: > 0 });
        }
        catch
        {
            return DashboardSummaryService.ResolvePostLoginRoute(
                isCoreSetupComplete: true,
                lastSelectedMode: SearchUiSessionService.GetLastSelectedModeRoute(),
                hasCompletedRun: false);
        }
    }

    private sealed class SetupModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class OnboardingStatusResponse
    {
        public bool IsCoreSetupComplete { get; set; }
    }
}