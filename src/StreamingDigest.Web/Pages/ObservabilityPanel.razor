@using StreamingDigest.Web.Models

@inject SearchUiSessionService SearchUiSessionService

@if (isLoaded)
{
    <section class="observability-panel">
        <div class="observability-header">
            <h3>Observability</h3>
            @if (isEnabled)
            {
                <span class="observability-status @(isReady ? "is-ready" : "is-starting")">
                    @(isReady ? "Ready" : "Starting")
                </span>
            }
            else
            {
                <span class="observability-status is-disabled">Disabled</span>
            }
        </div>

        @if (isEnabled && links.Count > 0)
        {
            <p class="observability-summary">
                @(isReady
                    ? "Open the configured dashboards directly from the app."
                    : "Observability is enabled. Some services are still coming online, but the configured dashboards are already linked here.")
            </p>

            <ul class="observability-links" aria-label="Observability dashboards">
                @foreach (var link in links)
                {
                    <li>
                        <a class="observability-link-card" href="@link.Url" target="_blank" rel="noopener noreferrer">
                            <span class="link-label">@link.Label</span>
                            <span class="link-description">@link.Description</span>
                        </a>
                    </li>
                }
            </ul>
        }
        else if (isEnabled)
        {
            <p class="observability-summary">
                Observability is enabled, but no dashboard links are configured yet.
            </p>
        }
        else
        {
            <p class="observability-summary">
                Observability is currently disabled. Re-enable it from the settings page to see links here.
            </p>
        }
    </section>
}

@code {
    private bool isLoaded;
    private bool isEnabled;
    private bool isReady;
    private IReadOnlyList<ObservabilityLinkDefinition> links = Array.Empty<ObservabilityLinkDefinition>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await SearchUiSessionService.GetAuthenticatedJsonAsync<ObservabilityStatus>("/api/observability");
            if (status is null)
            {
                return;
            }

            isEnabled = status.Enabled;
            isReady = status.Ready;
            links = status.Links ?? Array.Empty<ObservabilityLinkDefinition>();
        }
        catch
        {
            isEnabled = false;
            isReady = false;
        }
        finally
        {
            isLoaded = true;
        }
    }

    private sealed class ObservabilityStatus
    {
        public bool Enabled { get; set; }
        public bool Ready { get; set; }
        public IReadOnlyList<ObservabilityLinkDefinition>? Links { get; set; }
    }
}
