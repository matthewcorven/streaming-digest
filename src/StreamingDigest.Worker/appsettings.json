{
  "$schema": "./appsettings.schema.json",
  "appVersion": "0.8.1",
  "configSchemaVersion": "1.0.0",
  "deploymentSchemaVersion": "1.0.0",
  "app": {
    "name": "streaming-digest",
    "environment": "Development",
    "mutableSettingsStore": "file"
  },
  "runtime": {
    "enableHttpRedirect": true,
    "defaultTheme": "system",
    "paginationPageSize": 25
  },
  "connectionStrings": {
    "streamingdigest": "Host=localhost;Port=5432;Database=streamingdigest;Username=postgres;Password=postgres"
  },
  "logging": {
    "level": "Information"
  },
  "scraping": {
    "respectRobotsTxtByDefault": true,
    "rateLimitDelayMs": 1000,
    "domainOverrides": []
  },
  "screenshots": {
    "offsetSeconds": 5,
    "quality": 80
  },
  "ingestion": {
    "preferredMetadataSource": "youtube_api",
    "minDurationSeconds": 61,
    "defaultMaxAgeDays": 30,
    "scheduler": {
      "enabled": true,
      "scheduleHour": 6,
      "scheduleMinute": 0
    }
  }
}
