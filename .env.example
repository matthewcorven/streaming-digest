# Compose-only credential placeholders for published docker-compose runs.
# Local Aspire AppHost runs read these from AppHost user-secrets instead.

# Grafana (local-only defaults)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Postgres (local-only defaults)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin (local-only defaults)
PGADMIN_DEFAULT_EMAIL=admin@streamingdigest.local
PGADMIN_DEFAULT_PASSWORD=admin

# Compose bind mounts emitted by Aspire publish
GRAFANA_BINDMOUNT_0=./compose/observability/grafana/provisioning
GRAFANA_BINDMOUNT_1=./compose/observability/grafana/dashboards
LOKI_BINDMOUNT_0=./compose/observability/loki-config.yaml
OTEL_COLLECTOR_BINDMOUNT_0=./compose/observability/otel-collector.yaml
PROMETHEUS_BINDMOUNT_0=./compose/observability/prometheus.yml
TEMPO_BINDMOUNT_0=./compose/observability/tempo.yaml

# Matrix notification defaults
NOTIFICATIONS_MATRIX_ENABLED=false
NOTIFICATIONS_MATRIX_HOMESERVER_URL=https://matrix-client.matrix.org
NOTIFICATIONS_MATRIX_ACCESS_TOKEN=
NOTIFICATIONS_MATRIX_ROOM_ID=
NOTIFICATIONS_MATRIX_BOT_USER_ID=
NOTIFICATIONS_MATRIX_DASHBOARD_BASE_URL=http://localhost:8080
